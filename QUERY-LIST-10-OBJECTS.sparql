# ============================================================================
# LISTAR os primeiros 10 objetos SOC-LOCATION com TODAS as propriedades
# ============================================================================

PREFIX hasco: <http://hadatac.org/ont/hasco#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?originalID ?label ?type ?spaceScopeUri
WHERE {
  GRAPH <https://hadatac.org/ont/hadatac#/DFL1775048338616071> {
    ?obj rdf:type hasco:StudyObject .
    ?obj hasco:isMemberOf <http://hadatac.org/ont/arrowhead/OCL_LTE-PIAGET-LOCATION> .
    ?obj hasco:originalID ?originalID .
    OPTIONAL { ?obj rdfs:label ?label }
    OPTIONAL { ?obj rdf:type ?type }
    OPTIONAL { ?obj hasco:hasSpaceScope ?spaceScopeUri }
  }
}
ORDER BY ?originalID
LIMIT 10

# Resultado esperado:
# - originalID: ADMIN-L0, ADMIN-L1, ADMIN-L2, etc.
# - label: Admin Building Level 0, etc.
# - spaceScopeUri: http://hadatac.org/ont/arrowhead/indoor, outdoor, etc.

