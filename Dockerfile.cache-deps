# Stage 1: Cache all SBT dependencies
FROM sbtscala/scala-sbt:eclipse-temurin-11.0.16_1.7.2_2.12.17 as deps-cache

RUN apt-get update && apt-get install -y unzip
ENV JAVA_OPTS="-Xms6048m -Xmx10000m"
WORKDIR /hascoapi

# Copy only build files first (for dependency caching)
COPY build.sbt /hascoapi/
COPY project/*.sbt project/*.properties /hascoapi/project/

# Download all dependencies (this layer will be cached)
RUN sbt update || true
RUN sbt playUpdateSecret || true

# Stage 2: Actual build with cached dependencies
FROM sbtscala/scala-sbt:eclipse-temurin-11.0.16_1.7.2_2.12.17 as build-java

RUN apt-get update && apt-get install -y unzip
ENV JAVA_OPTS="-Xms6048m -Xmx10000m"
WORKDIR /hascoapi

# Copy cached dependencies from first stage
COPY --from=deps-cache /root/.ivy2 /root/.ivy2
COPY --from=deps-cache /root/.sbt /root/.sbt
COPY --from=deps-cache /root/.cache /root/.cache

# Now copy all source code
COPY . /hascoapi

# Build the application (dependencies already cached)
RUN sbt playUpdateSecret && sbt dist
RUN cd /hascoapi/target/universal/ && unzip hascoapi-10.0.1-SNAPSHOT.zip

# Stage 3: Runtime
FROM eclipse-temurin:11-jre

WORKDIR /hascoapi

COPY --from=build-java /hascoapi/target/universal/hascoapi-10.0.1-SNAPSHOT /hascoapi
COPY ./conf/hascoapi-docker.conf /hascoapi/conf/hascoapi.conf
COPY ./docker-entrypoint.sh /hascoapi/docker-entrypoint.sh
COPY ./load-pharma-ontology.sh /hascoapi/load-pharma-ontology.sh
COPY ./app_ontology/pharma.owl /var/hascoapi/app_ontology/pharma.owl

RUN chmod +x /hascoapi/docker-entrypoint.sh
RUN chmod +x /hascoapi/load-pharma-ontology.sh

EXPOSE 9000

ENTRYPOINT [ "/hascoapi/docker-entrypoint.sh" ]
