FROM sbtscala/scala-sbt:eclipse-temurin-11.0.16_1.7.2_2.12.17

WORKDIR /hascoapi

COPY . .

EXPOSE 9000

CMD ["bash", "-lc", "retry=${SBT_UPDATE_RETRY_SECONDS:-90}; until sbt -batch update; do echo \"[hascoapi] sbt update falhou (ex.: HTTP 429). Retry em ${retry}s...\"; sleep \"${retry}\"; done; exec sbt -batch run"]
