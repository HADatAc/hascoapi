# ============================================================================
# DEBUG: Ver O QUE está no named graph DFL1775048338616071
# ============================================================================

# Query 1: Ver TODOS os tipos de objetos no graph
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?type (COUNT(?s) as ?count)
WHERE {
  GRAPH <https://hadatac.org/ont/hadatac#/DFL1775048338616071> {
    ?s rdf:type ?type .
  }
}
GROUP BY ?type
ORDER BY DESC(?count)

# ============================================================================

# Query 2: Ver os primeiros 20 triples do graph (SEM filtro de tipo)
SELECT ?s ?p ?o
WHERE {
  GRAPH <https://hadatac.org/ont/hadatac#/DFL1775048338616071> {
    ?s ?p ?o .
  }
}
LIMIT 20

# ============================================================================

# Query 3: Buscar objetos com hasco:originalID (independente do tipo)
PREFIX hasco: <http://hadatac.org/ont/hasco#>

SELECT ?obj ?originalID
WHERE {
  GRAPH <https://hadatac.org/ont/hadatac#/DFL1775048338616071> {
    ?obj hasco:originalID ?originalID .
  }
}
LIMIT 20

