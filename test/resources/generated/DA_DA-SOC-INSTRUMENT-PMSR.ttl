pmsr:OBJ_instrumentcollection_INS1739821032633525
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "This involves the use of digital technologies to monitor and collect medical and health data from patients in one location, which is then electronically transmitted to healthcare providers in a different location for assessment and recommendations. RPM enables continuous monitoring of patient health data, facilitating proactive management of chronic conditions and post-operative care. Devices used in RPM include blood pressure monitors, glucose meters, and wearable sensors that track various physiological parameters." ;
        rdfs:label                      "Monitoring Virtual Simulator" ;
        rdfs:subClassOf                 "vstoi:Model" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
