pmsr:OBJ_instrumentcollection_INS1739488340413085
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A Virtual Patient Interaction Simulator is an interactive computer-based program designed to emulate real-life clinical scenarios, enabling healthcare professionals and students to practice patient interactions, clinical decision-making, and diagnostic skills in a risk-free environment. These simulators present users with virtual patients exhibiting various medical conditions, allowing learners to engage in patient interviews, physical examinations, and management planning." ;
        rdfs:label                      "Virtual Patient Interaction Simulator" ;
        rdfs:subClassOf                 "pmsr:VirtualMedicalSimulator" ;
