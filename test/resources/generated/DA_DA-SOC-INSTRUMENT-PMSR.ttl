pmsr:OBJ_instrumentcollection_INS1739301081410085
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "An intraoral scanner is a handheld device used in dentistry to create precise digital impressions of a patient's oral cavity, including teeth and gums. By projecting a light source onto the area to be scanned, the device captures a series of images that are processed by specialized software to produce an accurate 3D model of the intraoral structures." ;
        rdfs:label                      "Intraoral Scanner" ;
        rdfs:subClassOf                 "pmsr:/INS1739300958884615" ;
