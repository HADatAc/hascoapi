pmsr:OBJ_instrumentcollection_INS1739288428472235
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "An ultrasound simulator is a training tool designed to replicate the experience of performing ultrasound examinations, enabling healthcare professionals to develop and refine their sonography skills in a controlled, risk-free environment. These simulators typically consist of a mock probe connected to a computer system that displays ultrasound images corresponding to the probe's position and movements. Advanced models may include a human mannequin or torso to enhance the realism of the training experience." ;
        rdfs:label                      "Ultrasound" ;
        rdfs:subClassOf                 "ncit:C16830" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
