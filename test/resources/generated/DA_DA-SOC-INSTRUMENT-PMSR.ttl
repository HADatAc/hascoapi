pmsr:OBJ_instrumentcollection_INS1739451831725785
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A Virtual Patient Anatomy Simulator is an advanced educational tool that combines interactive computer simulations with detailed anatomical models to enhance healthcare training. These simulators allow learners to engage in realistic clinical scenarios while exploring human anatomy in a virtual environment." ;
        rdfs:label                      "Virtual Patient Anatomy Simulator" ;
        rdfs:subClassOf                 "pmsr:VirtualMedicalSimulator" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://geekymedics.com/virtual-patient-simulator/" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739451831725785" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/VirtualPatientAnatomySimulator" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

pmsr:OBJ_instrumentcollection_INS1739288499528465
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "The Chison CBit 9 is a cart-based digital color Doppler ultrasound system designed to deliver high-quality imaging across various medical specialties, including cardiology, obstetrics and gynecology, radiology, and point-of-care applications. It features a 21.5-inch high-definition LED monitor and a 10.1-inch customizable touch screen, enhancing user interaction and image visualization. The system supports multiple transducer types, such as convex, linear, transvaginal, and phased array probes, providing versatility for comprehensive diagnostic needs. Advanced imaging technologies integrated into the CBit 9 include Auto EF, Strain and Strain Rate, Stress Echo, Tissue Doppler Imaging (TDI), SonoContrast, Shear Wave Elastography, and 4D imaging capabilities. These features collectively enhance diagnostic accuracy and efficiency, making the CBit 9 a valuable tool in modern medical practice." ;
        rdfs:label                      "Chison Cbit-9 Stationary Ultrasound" ;
        rdfs:subClassOf                 "pmsr:/INS1739288428472235" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.chison.com/cbit/cbit-9.html" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739288499528465" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/ChisonCbit9StationaryUltrasound" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

pmsr:OBJ_instrumentcollection_INS1739288006994165
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A Diagnostic Imaging Simulator is a specialized training tool designed to replicate medical imaging procedures, such as MRI, CT scans, and X-rays, in a controlled and risk-free environment. These simulators enable healthcare professionals and students to practice image acquisition, interpretation, and patient management without exposing patients to actual procedures or ionizing radiation." ;
        rdfs:label                      "Diagnostic Imaging Simulator" ;
        rdfs:subClassOf                 "pmsr:/INS1739287021517805" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://widi.xray.ufl.edu/widi-sim/emergent-critical-care-imaging-simulation/" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739288006994165" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/DiagnosticImagingSimulator" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

pmsr:OBJ_instrumentcollection_INS1739392122823235
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "Training in medical/surgical procedures, including those that are rare or complex. Medical educators use simulators such as lifelike mannequins or virtual representations of patients to practice clinical scenarios. These tools can simulate realistic anatomy, tissue, and tactile feedback. Other simulators prepare clinicians for procedures by using realistic workflows, including planning, warm-up exercises, and rehearsal for a specific procedure." ;
        rdfs:label                      "Procedure Simulator" ;
        rdfs:subClassOf                 "pmsr:PhysicalMedicalSimulator" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.nibib.nih.gov/science-education/science-topics/medical-simulators" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739392122823235" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/ProcedureSimulator" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

pmsr:OBJ_instrumentcollection_INS1739301189412025
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A CAD-CAM system integrates Computer-Aided Design (CAD) and Computer-Aided Manufacturing (CAM) technologies to streamline the design and production processes. CAD involves the use of computer software to create detailed 2D or 3D models of products, enabling designers and engineers to visualize and refine their concepts digitally. CAM utilizes these digital models to control and automate manufacturing equipment, such as CNC machines, facilitating the efficient and precise production of physical components. This integration enhances productivity, reduces manual intervention, and ensures a seamless transition from design to manufacturing." ;
        rdfs:label                      "CAD-CAM System" ;
        rdfs:subClassOf                 "pmsr:/INS1739300958884615" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.autodesk.com/solutions/cad-cam" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739301189412025" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/CADCAMSystem" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

pmsr:OBJ_instrumentcollection_INS1739303195193785
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "The Geriatric Simulator is an award-winning educational tool designed to help students develop empathy and a deeper understanding of the challenges faced by older patients or individuals with limited mobility. This wearable simulator allows students to experience firsthand the physical and visual impairments that many older adults live with daily, including stooped posture, restricted range of motion, and conditions like glaucoma." ;
        rdfs:label                      "Geriatic Care Simulator" ;
        rdfs:subClassOf                 "pmsr:/INS1739301711235865" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.realityworks.com/product/realcare-geriatric-simulator/?srsltid=AfmBOooiYNGJCNfk6Mw3AETNgjYD0eXXI9BSZNJmKgo7ITKMKCF_D" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739303195193785" ;
