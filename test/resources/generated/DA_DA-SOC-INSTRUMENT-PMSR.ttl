        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.artec3d.com/portable-3d-scanners/artec-leo" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        <http://hadatac.org/ont/pharma#altitude_m>
