pmsr:OBJ_instrumentcollection_INS1739301133578555
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "An extraoral scanner is a device used in dentistry to capture detailed digital impressions of a patient's dental structures from outside the mouth. Unlike intraoral scanners, which acquire images from within the oral cavity, extraoral scanners digitize physical models or impressions of the teeth and jaws. This process involves scanning gypsum casts or conventional impressions to create accurate 3D digital models. These digital representations are then utilized in computer-aided design and manufacturing (CAD/CAM) workflows for designing and fabricating dental prosthetics, such as crowns, bridges, and implants. Extraoral scanners are particularly valued for their precision and are commonly employed in dental laboratories to ensure high-quality restorative outcomes." ;
        rdfs:label                      "Extraoral Scanner" ;
        rdfs:subClassOf                 "pmsr:/INS1739300958884615" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.mdpi.com/2077-0383/12/18/5833" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739301133578555" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/ExtraoralScanner" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

