pmsr:OBJ_instrumentcollection_INS1739288625580975
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "The Butterfly iQ+ is a portable, handheld ultrasound device designed to provide whole-body imaging through a single probe. Utilizing advanced ultrasound-on-chip technology, it connects seamlessly to iOS and Android devices via the Butterfly iQ app, offering over 20 presets for various clinical applications. This innovation allows healthcare professionals to perform diagnostic imaging and measurements across multiple areas, including abdominal, cardiac, lung, bladder, musculoskeletal, and obstetric assessments. The device is particularly valuable in diverse settings, from traditional clinical environments to remote areas lacking access to conventional ultrasound equipment. Its user-friendly interface and comprehensive imaging capabilities make it a versatile tool in modern medical practice." ;
        rdfs:label                      "Butterfly IQ+" ;
        rdfs:subClassOf                 "pmsr:/INS1739288566447555" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
