pmsr:OBJ_instrumentcollection_INS1740087575777435
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A patient monitor simulator is a specialized device used to test and verify the performance of patient monitoring equipment. These simulators generate precise physiological signals that mimic human vital signs, allowing biomedical technicians and healthcare professionals to ensure that patient monitors are accurately measuring and displaying data such as heart rate, blood pressure, respiratory rate, and other critical parameters. Regular testing with patient monitor simulators is essential to maintain the reliability and safety of monitoring devices, ensuring they function correctly during patient care." ;
        rdfs:label                      "Patient Monitor Simulator" ;
        rdfs:subClassOf                 "pmsr:/INS1739821032633525" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
