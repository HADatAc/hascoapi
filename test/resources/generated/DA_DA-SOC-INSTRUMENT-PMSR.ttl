        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "Healthcare Simulation is the modern way to educate and train healthcare professionals to master cognitive, technical, and behavioral skill sets through technologically advanced, crafted experiences. This experiential learning style enables professionals and learners to practice and test their profession while building confidence in their abilities before working in real-world scenarios. In addition, Medical Simulation mimics a clinical situation without the risk of potentially harmful clinical outcomes. Healthcare Simulation is also referred to as Medical Simulation, Clinical Simulation, or, in specific circumstances, Surgical Simulation and Nursing Simulation. Check out the homepage for the latest clinical simulation CE courses, webinars, books, research, conferences and jobs!" ;
        rdfs:label                      "Care Simulators" ;
        rdfs:subClassOf                 "pmsr:PhysicalMedicalSimulator" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-INSTRUMENT-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-INSTRUMENT-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:41:26.495Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.healthysimulation.com/healthcare-simulation/" ;
        hasco:hascoType                 "vstoi:Instrument" ;
        vstoi:hasInstrument             "pmsr:INST-INS1739301711235865" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasShortName              "pmsr:/CareSimulators" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

pmsr:OBJ_instrumentcollection_INS1739288297796655
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A Vascular Access Ultrasound Simulator is a specialized training tool designed to help healthcare professionals develop and refine the skills necessary for performing ultrasound-guided vascular access procedures. These simulators provide a controlled environment where practitioners can practice techniques such as venipuncture, central venous catheterization, and arterial line insertion without posing any risk to actual patients." ;
        rdfs:label                      "Vascular Access Ultrasound Simulator" ;
        rdfs:subClassOf                 "pmsr:/INS1739288153666735" ;
