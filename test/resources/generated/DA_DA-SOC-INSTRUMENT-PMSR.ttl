pmsr:OBJ_instrumentcollection_INS1739288566447555
        rdf:type                        "vstoi:Instrument" ;
        rdfs:comment                    "A portable ultrasound is a compact medical imaging device designed to be easily transported and used in various settings, including small spaces, patient bedsides, or in the field. These devices utilize high-frequency sound waves to create images of internal body structures, aiding in the diagnosis and monitoring of medical conditions. Portable ultrasound machines can be cart-based, tablet-based, or hand-carried, offering flexibility and convenience in diverse clinical environments." ;
        rdfs:label                      "Portable Ultrasound" ;
        rdfs:subClassOf                 "pmsr:/INS1739288428472235" ;
