pmsr:ROP1740092979307615
        rdf:type                        "vstoi:ResponseOption" ;
        rdfs:comment                    "Dorsal arch veins are small, but easily cannulated and last surprisingly well.  The vein on the lateral aspect, running below malleolus, is easy to access, but must be splinted carefully and watched for infiltration. Veins leading up to short saphenous are often good options." ;
        rdfs:label                      "LOC ROP1740092979307615 - STD-STUDY-PMSR" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-RESPONSE-OPTION-PMSR.csv" ;
