pmsr:ROP1740092758910575
        rdf:type                        "vstoi:ResponseOption" ;
        rdfs:comment                    "Dorsal arch veins are best seen on the back of the hand, but are usually larger and easier to see and palpate over the back of the wrist.  Skin entry should be more distally. IVs inserted here are easily splinted and any infiltration easily spotted, so these veins are the preferred site. The feeder veins over the dorsum of the hand in the first interspace need to be treated with respect, as it is possible to cannulate an artery here, risking loss of a thumb, or part thereof. (princeps pollicis artery). This is present in about 10% of infants.  If present it is usually the sole supply to thumb." ;
        rdfs:label                      "LOC ROP1740092758910575 - STD-STUDY-PMSR" ;
        hasco:hasDataAcquisition        "http://example.org/roundtrip/DA-DA-SOC-RESPONSE-OPTION-PMSR.csv" ;
        hasco:hasDataAcquisition        <http://example.org/roundtrip/DA-DA-SOC-RESPONSE-OPTION-PMSR.csv> ;
        hasco:hasDataFile               "http://example.org/roundtrip/DFL-DA-SOC-RESPONSE-OPTION-PMSR.csv" ;
        hasco:hasTimestamp              "2026-06-03T19:38:49.023Z" ;
        hasco:hasTotalRecordedMessages  "0" ;
        hasco:hasWebDocument            "https://www.safercare.vic.gov.au/best-practice-improvement/clinical-guidance/neonatal/peripheral-intravenous-iv-catheter-inserti" ;
        hasco:hascoType                 "vstoi:ResponseOption" ;
        vstoi:hasContent                "pmsr:/Neonatal Hand Dorsal arch veins" ;
        vstoi:hasLanguage               "pmsr:/en" ;
        vstoi:hasStatus                 "UNPROCESSED" ;
        vstoi:hasVersion                "pmsr:/1" .

