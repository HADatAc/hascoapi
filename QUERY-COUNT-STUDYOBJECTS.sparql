# ============================================================================
# QUERY SUPER SIMPLES: Contar quantos StudyObjects existem
# ============================================================================

PREFIX hasco: <http://hadatac.org/ont/hasco#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?soc (COUNT(?obj) as ?count)
WHERE {
  GRAPH <https://hadatac.org/ont/hadatac#/DFL1775048338616071> {
    ?obj rdf:type hasco:StudyObject .
    ?obj hasco:isMemberOf ?soc .
  }
}
GROUP BY ?soc
ORDER BY ?soc


