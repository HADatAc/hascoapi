<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:pharma="https://pharma.graxiom.com/ont/"
         xml:base="https://pharma.graxiom.com/ont/">

  <owl:Ontology rdf:about="https://pharma.graxiom.com/ont/">
    <rdfs:label>Pharmaceutical Manufacturing Ontology</rdfs:label>
    <rdfs:comment>Core ontology for pharmaceutical manufacturing domain</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <!-- Equipment Requirement Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/EquipmentRequirement">
    <rdfs:label>Equipment Requirement</rdfs:label>
    <rdfs:comment>Capability-based equipment requirement for manufacturing operations</rdfs:comment>
  </owl:Class>

  <!-- Corporation Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/Corporation">
    <rdfs:label>Corporation</rdfs:label>
    <rdfs:comment>Corporate entity</rdfs:comment>
  </owl:Class>

  <!-- Business Unit Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/BusinessUnit">
    <rdfs:label>Business Unit</rdfs:label>
    <rdfs:comment>Organizational business unit</rdfs:comment>
  </owl:Class>

  <!-- Department Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/Department">
    <rdfs:label>Department</rdfs:label>
    <rdfs:comment>Organizational department</rdfs:comment>
  </owl:Class>

  <!-- Role Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/Role">
    <rdfs:label>Role</rdfs:label>
    <rdfs:comment>Organizational role</rdfs:comment>
  </owl:Class>

  <!-- Person Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/Person">
    <rdfs:label>Person</rdfs:label>
    <rdfs:comment>Person in the organization</rdfs:comment>
  </owl:Class>

  <!-- Time Period Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/TimePeriod">
    <rdfs:label>Time Period</rdfs:label>
    <rdfs:comment>Temporal period</rdfs:comment>
  </owl:Class>

  <!-- ERP Supplier Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/ERPSupplier">
    <rdfs:label>ERP Supplier</rdfs:label>
    <rdfs:comment>External supplier in ERP system</rdfs:comment>
  </owl:Class>

  <!-- Operation Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/Operation">
    <rdfs:label>Operation</rdfs:label>
    <rdfs:comment>ISA-88 Operation</rdfs:comment>
  </owl:Class>

  <!-- Unit Procedure Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/UnitProcedure">
    <rdfs:label>Unit Procedure</rdfs:label>
    <rdfs:comment>ISA-88 Unit Procedure</rdfs:comment>
  </owl:Class>

  <!-- Phase Class -->
  <owl:Class rdf:about="https://pharma.graxiom.com/ont/Phase">
    <rdfs:label>Phase</rdfs:label>
    <rdfs:comment>ISA-88 Phase</rdfs:comment>
  </owl:Class>

  <!-- Equipment Requirement Properties -->
  <owl:ObjectProperty rdf:about="https://pharma.graxiom.com/ont/dexpi_requiredClass">
    <rdfs:label>DEXPI Required Class</rdfs:label>
    <rdfs:comment>DEXPI equipment class required for this operation</rdfs:comment>
    <rdfs:domain rdf:resource="https://pharma.graxiom.com/ont/EquipmentRequirement"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="https://pharma.graxiom.com/ont/processFunction">
    <rdfs:label>Process Function</rdfs:label>
    <rdfs:comment>Formal process function term (controlled vocabulary)</rdfs:comment>
    <rdfs:domain rdf:resource="https://pharma.graxiom.com/ont/EquipmentRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://pharma.graxiom.com/ont/materialType">
    <rdfs:label>Material Type</rdfs:label>
    <rdfs:comment>Formal material type term (controlled vocabulary)</rdfs:comment>
    <rdfs:domain rdf:resource="https://pharma.graxiom.com/ont/EquipmentRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://pharma.graxiom.com/ont/precisionLevel">
    <rdfs:label>Precision Level</rdfs:label>
    <rdfs:comment>Required precision level for equipment</rdfs:comment>
    <rdfs:domain rdf:resource="https://pharma.graxiom.com/ont/EquipmentRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://pharma.graxiom.com/ont/criticalityLevel">
    <rdfs:label>Criticality Level</rdfs:label>
    <rdfs:comment>GxP criticality classification</rdfs:comment>
    <rdfs:domain rdf:resource="https://pharma.graxiom.com/ont/EquipmentRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

</rdf:RDF>
